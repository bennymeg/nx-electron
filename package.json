{
  "name": "nx-electron",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Electron Plugin for Nx",
  "author": "Benny Megidish",
  "scripts": {
    "start": "nx run nx-electron:serve",
    "build": "nx run nx-electron:build",
    "link": "npm link ./dist/packages/nx-electron/",
    "test": "nx run nx-electron:test",
    "test:watch": "nx run nx-electron:test -- --watch",
    "lint": "nx run nx-electron:lint",
    "migrate": "nx migrate latest",
    "publish": "cd dist/packages/nx-electron && npm publish",
    "publish:alpha": "cd dist/packages/nx-electron && npm publish --tag alpha",
    "publish:beta": "cd dist/packages/nx-electron && npm publish --tag beta",
    "release": "cd packages/nx-electron && npm run release"
  },
  "private": true,
  "devDependencies": {
    "@nx/devkit": "^23.2.0",
    "@nx/eslint": "^23.2.0",
    "@nx/eslint-plugin": "^23.2.0",
    "@nx/jest": "^23.2.0",
    "@nx/js": "^23.2.0",
    "@nx/node": "^23.2.0",
    "@nx/plugin": "^23.2.0",
    "@nx/workspace": "^23.2.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "^1.16.2",
    "@types/jest": "29.5.14",
    "@types/node": "^20.14.2",
    "@types/webpack": "^5.28.5",
    "@types/webpack-node-externals": "^3.0.4",
    "bufferutil": "^4.0.9",
    "copy-webpack-plugin": "^12.0.2",
    "electron": "^34.5.6",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "10.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jest": "29.7.0",
    "license-webpack-plugin": "^4.0.2",
    "nx": "^23.2.0",
    "prettier": "3.2.5",
    "shx": "^0.4.0",
    "standard-version": "^9.5.0",
    "strip-json-comments": "^3.1.1",
    "terser-webpack-plugin": "^5.3.14",
    "tree-kill": "^1.2.2",
    "ts-jest": "29.4.9",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.99.9",
    "webpack-merge": "^5.10.0",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "electron-builder": "^26.0.0",
    "rxjs": "^7.8.2",
    "rxjs-for-await": "^1.0.0"
  },
  "engines": {
    "node": ">= 18.0.0"
  }
}
